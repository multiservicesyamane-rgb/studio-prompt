# Clés API : ne jamais publier
.env
.env.*
!.env.example

node_modules/
*.log

# Vidéos et captures de références (lourdes, et souvent les vidéos d'autres créateurs)
references/videos/
references/images/
references/*-echec.png

# Outils de l'éditeur
.kilocode/
.vscode/

# Sorties des tests (captures, fichiers générés)
tests/out/
tests/.ref-review/
public/generated/

# Documents et médias de référence : ne JAMAIS publier (droits d'auteur Adobe/Google/DaVinci, et taille)
*.pdf
*.zip
*.rar
public/*.jpg
public/*.jpeg
public/*.jfif
public/*.png
references/*.mp4
.tmp_reference_*/
