# Copie ce fichier en « .env » puis mets ta clé. Ne partage JAMAIS le fichier .env.

# Option 1 (conseillée pour commencer) : Gemini. Clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Facultatif : impose un modèle précis. Laisse vide pour prendre automatiquement le plus récent.
GEMINI_MODEL=
GEMINI_MODEL_PRO=

# Option 2 : OpenAI (API payante, crédits à part de l'abonnement ChatGPT). Clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Qualité « Standard » et « Maximale » ; effort de réflexion : low, medium, high
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MODEL_PRO=gpt-6-astra
OPENAI_EFFORT=medium
OPENAI_EFFORT_PRO=high

# Option 3 : Claude (API Anthropic, payante). Clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_PRO=claude-opus-5-5

# Si tu as plusieurs clés, choisis le moteur des agents : gemini, openai ou anthropic
PROVIDER=

PORT=3000
MAX_OUTPUT_TOKENS=32000

# Images automatiques des plans (Nano Banana)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
IMAGE_TIMEOUT_MS=180000

# Analyse multimodale des vidéos complètes (images + audio + paroles + montage)
GEMINI_VIDEO_MODEL=
VIDEO_ANALYSIS_TIMEOUT_MS=600000
VIDEO_ANALYSIS_MAX_TOKENS=32000

# Fabrication des voix et des vidéos (page « Connexions et voix » de Studio Prompt)
# Voix gratuites : ta clé GEMINI_API_KEY suffit.
# ElevenLabs (facultatif, petite quantité gratuite chaque mois) :
ELEVENLABS_API_KEY=
# PAYANT, seulement si tu l'actives un jour : clé d'un AUTRE projet Google, avec facturation (Veo, images).
# Ta clé GEMINI_API_KEY reste gratuite pour les histoires et les voix.
GEMINI_MEDIA_API_KEY=
# Runway (crédits API, différents de l'abonnement du site) :
RUNWAY_API_KEY=
# Dépense maximale par jour, en dollars, pour tout ce qui est payant :
GEN_BUDGET_USD=5

# Manus AI (facultatif, crédits Manus) : boutons « Créer avec Manus AI » (Storyboard) et « Générer le visuel avec Manus » (Images).
# Les images restent sur le site de Manus : télécharge-les, puis dépose-les avec « Importer mes images » dans le Storyboard.
MANUS_API_KEY=
