{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "echo \"Studio Prompt : le site est le dossier public\"",
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]}
  ]
}
